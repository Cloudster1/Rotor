{
  "description": "Credentials Rotor cuts from every event, run output, log line, span and audit record (#41). The control plane embeds a copy and the runner packages one; make secret-patterns copies this file and a test on each side refuses a copy that differs. Patterns use only syntax Go's RE2 and Python's re read alike: no lookaround, scoped flags only.",
  "redacted": "[redacted]",
  "patterns": [
    "\\b(?i:bearer)\\s+[A-Za-z0-9._~+/=-]+",
    "\\b(?:rotor_(?:pat|oat|ort|oac|ocs)_|exciter_(?:pat|whs|oat|ort|ocs|oac)_|armature_(?:pat|whs)_|stator_(?:pat|whs)_|stub_(?:oat|ort|ocs|pat)_|lsv2_|hv[sbr]\\.)[A-Za-z0-9._~+/=-]+",
    "\\bsk-ant-[A-Za-z0-9_-]+",
    "\\bsk-(?:proj-)?[A-Za-z0-9_-]{16,}",
    "\\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})",
    "\\bglpat-[A-Za-z0-9_-]{20,}",
    "\\bxox[abprs]-[A-Za-z0-9-]{10,}",
    "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
    "\\bAIza[0-9A-Za-z_-]{35}",
    "\\b(?:sk|rk)_live_[0-9A-Za-z]{16,}",
    "\\beyJ[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*",
    "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----",
    "//[^/\\s:@\"\\\\]+:[^/\\s@\"\\\\]+@"
  ],
  "secretKeys": ["authorization", "token", "secret", "password", "api_key", "apikey", "credential"],
  "secretStates": ["set", "kept", "removed"]
}
