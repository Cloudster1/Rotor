    },
    {
      "annotations": {
        "readOnlyHint": false,
        "title": "bulk_edit_issues"
      },
      "description": "Change many issues at once: priority, assignee, sprint, milestone, team, labels, or a transition by name; each refusal is named.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "change": {
            "$ref": "#/$defs/Input"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "keys",
          "change"
        ],
        "$defs": {
          "Input": {
            "type": "object",
            "properties": {
              "addLabels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "assignee": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "milestoneId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "lowest",
                  "low",
                  "medium",
                  "high",
                  "highest"
                ]
              },
              "sprintId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "teamId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "transition": {
                "type": "string"
              }
            }
          }
        }
      },
      "name": "bulk_edit_issues"
    },
