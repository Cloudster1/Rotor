    {
      "annotations": {
        "readOnlyHint": false,
        "title": "add_comment"
      },
      "description": "Comment on an issue; text is plain words.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "description": "A rich text document.",
            "properties": {
              "content": {
                "type": "array",
                "items": {
                  "description": "A node of the document."
                }
              },
              "type": {
                "type": "string",
                "enum": [
                  "doc"
                ]
              }
            },
            "required": [
              "type",
              "content"
            ]
          },
          "bodyMarkdown": {
            "type": "string"
          },
          "issueKey": {
            "type": "string",
            "description": "An issue key such as CP-12, or a project key such as CP."
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "issueKey"
        ]
      },
      "name": "add_comment"
    },
    {
      "annotations": {
        "readOnlyHint": false,
        "title": "add_remote_link"
