    {
      "annotations": {
        "readOnlyHint": true,
        "title": "get_report"
      },
      "description": "One report computed now; kind is a widget kind such as status_breakdown, throughput or velocity.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "description": "The window, 1 to 365."
          },
          "groupBy": {
            "type": "string",
            "description": "For a chart: status, statusCategory, type, priority, assignee, team, milestone, label, fixVersion or component."
          },
          "interval": {
            "type": "string",
            "description": "For a line: week or month."
          },
          "kind": {
            "type": "string"
          },
          "measure": {
            "type": "string",
            "description": "For a chart: count or points."
          },
          "milestone": {
            "type": "string",
            "format": "uuid",
            "description": "One milestone's progress, open or closed, instead of every open one's."
          },
          "projectKey": {
            "type": "string",
            "description": "An issue key such as CP-12, or a project key such as CP."
          },
          "q": {
            "type": "string",
            "description": "An NQL query the counted issues must match; the dashboard's filter, composed on the page."
          },
          "series": {
            "type": "string",
            "description": "For a line: created, resolved or open."
          },
          "shape": {
            "type": "string",
            "description": "For a chart: bar, stacked, donut or line."
          },
          "splitBy": {
            "type": "string",
            "description": "For a stacked chart: a second field from the same list."
          },
          "sprint": {
            "type": "string",
            "format": "uuid",
            "description": "One sprint's burndown, running or over."
          },
          "team": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "string",
            "format": "uuid",
            "description": "One version's progress, released or not, instead of every unreleased one's."
          }
        },
        "required": [
          "projectKey",
          "kind"
        ]
      },
      "name": "get_report"
    },
    {
