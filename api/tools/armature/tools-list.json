    {
      "annotations": {
        "readOnlyHint": true,
        "title": "list_project_issues"
      },
      "description": "A project's issues, filtered or narrowed by an NQL query in q.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "assignee": {
            "type": "string",
            "description": "A user id, \"me\", or \"none\"."
          },
          "category": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "todo",
                "in_progress",
                "done"
              ]
            }
          },
          "label": {
            "type": "array",
            "description": "Issues carrying any of these labels.",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "limit": {
            "type": "integer",
            "description": "1 to 200."
          },
          "milestone": {
            "type": "string",
            "format": "uuid",
            "description": "Issues counting towards this milestone."
          },
          "offset": {
            "type": "integer"
          },
          "order": {
            "type": "string",
            "description": "asc or desc; desc unless said."
          },
          "orderBy": {
            "type": "string",
            "description": "created, updated, priority, key, summary, status or rank."
          },
          "priority": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "lowest",
                "low",
                "medium",
                "high",
                "highest"
              ]
            }
          },
          "projectKey": {
            "type": "string",
            "description": "An issue key such as CP-12, or a project key such as CP."
          },
          "q": {
            "type": "string",
            "description": "An NQL query, such as assignee = currentUser() AND statusCategory != done ORDER BY priority DESC. Its ORDER BY outranks orderBy."
          },
          "reporter": {
            "type": "string",
            "description": "A user id or \"me\"."
          },
          "sprint": {
            "type": "string",
            "description": "A sprint id for the work committed to it, or \"none\" for the backlog."
          },
          "status": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "team": {
            "type": "string",
            "description": "A team id for the work it carries, or \"none\" for the project's own."
          },
          "text": {
            "type": "string",
            "description": "Words the summary contains."
          },
          "type": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "projectKey"
