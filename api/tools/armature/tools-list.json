          "relation": {
            "type": "string",
            "enum": [
              "page",
              "requirement"
            ]
          },
          "source": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "issueKey",
          "url",
          "title",
          "source"
        ]
