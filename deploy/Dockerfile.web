# The production image: the SPA built to static files and served by nginx, which also proxies the API
# so the browser sees one origin.
FROM node:26.10.0-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80 AS deps
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

# The build reads ../VERSION and ../api/openapi.json, as it does in a checkout.
FROM deps AS build
COPY VERSION /src/VERSION
COPY api/ /src/api/
COPY web/ ./
RUN npm run build

FROM nginx:1.29.8-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de
COPY --from=build /src/web/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
