# One image carries every backend binary; compose picks the one a service runs with its command.
# The dependencies compile in a layer that stays cached until an import changes.

FROM golang:1.26-alpine AS modules
WORKDIR /src
ENV GOFLAGS=-buildvcs=false GOTOOLCHAIN=local CGO_ENABLED=0
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# The list changes only when an import does, so the layer below that reads it is reused by every such commit.
FROM modules AS deplist
COPY backend/ ./
RUN go list -deps -f '{{if and (not .Standard) (ne .Module.Path "github.com/cloudster1/rotor/backend")}}{{.ImportPath}}{{end}}' ./cmd/... | sort -u > /deps.txt

FROM modules AS builder
# The flags match the final build's, or its cache would not be consulted.
COPY --from=deplist /deps.txt /deps.txt
RUN go build -trimpath $(cat /deps.txt)

COPY backend/ ./
COPY VERSION /VERSION

# goose drops the database drivers Rotor never uses under these tags.
ARG GOOSE_TAGS="no_sqlite3 no_mysql no_clickhouse no_vertica no_ydb no_libsql no_mssql no_turso no_duckdb"
# What the build says it is; make passes both from scripts/build-stamp.sh, and without them it is VERSION+dev.
ARG VERSION=""
ARG COMMIT=""
RUN PKG=github.com/cloudster1/rotor/backend/internal/version && \
    V="${VERSION:-$(tr -d '[:space:]' < /VERSION)+dev}" && \
    LDFLAGS="-s -w -X $PKG.Version=$V -X $PKG.Commit=$COMMIT -X $PKG.BuiltAt=$(date -u +%Y-%m-%dT%H:%M:%SZ)" && \
    go build -trimpath -ldflags="$LDFLAGS" -o /out/ ./cmd/api ./cmd/tool-stub ./cmd/worker && \
    go build -trimpath -ldflags="$LDFLAGS" -tags "$GOOSE_TAGS" -o /out/migrate ./cmd/migrate

# Alpine rather than scratch: the health check runs the binary, and an operator wants a shell to look around.
FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata && \
    adduser -D -u 10001 rotor
WORKDIR /app
COPY --from=builder /out/ /app/
# What the tool-stub answers to tools/list: Exciter's, recorded from the suite (make tool-snapshots).
COPY api/tools/exciter/tools-list.json /app/tools/exciter/tools-list.json
USER rotor
EXPOSE 8080
CMD ["/app/api"]
