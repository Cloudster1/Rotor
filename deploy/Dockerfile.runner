# The sandbox image: a relocatable Python and the runner's locked dependencies on a distroless base,
# with no shell, no package manager and a non-root user. Both bases are pinned by digest.

FROM ghcr.io/astral-sh/uv:0.9.30-python3.13-bookworm-slim@sha256:531f855bda2c73cd6ef67d56b733b357cea384185b3022bd09f05e002cd144ca AS builder
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PYTHON_PREFERENCE=only-managed \
    UV_PROJECT_ENVIRONMENT=/opt/venv
RUN uv python install 3.13
WORKDIR /src
# Dependencies first, so a change to the runner's own code reuses this layer.
COPY runner/pyproject.toml runner/uv.lock runner/.python-version runner/README.md ./
RUN uv sync --locked --no-dev --no-install-project
COPY runner/ ./
RUN uv sync --locked --no-dev --no-editable

FROM gcr.io/distroless/cc-debian12:nonroot@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f
COPY --from=builder /opt/python /opt/python
COPY --from=builder /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:/usr/bin:/bin \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
USER nonroot
ENTRYPOINT ["/opt/venv/bin/python", "-m", "rotor_runner"]
